# Password for nuxt-auth-utils (minimum 32 characters)
NUXT_SESSION_PASSWORD=
# GitHub OAuth client ID
NUXT_OAUTH_GITHUB_CLIENT_ID=
# GitHub OAuth client secret
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# Vercel AI gateway key
AI_GATEWAY_API_KEY=
# Blob read write token
BLOB_READ_WRITE_TOKEN=
# Turso database URL (not needed for local development)
TURSO_DATABASE_URL=
# Turso auth token (not needed for local development)
TURSO_AUTH_TOKEN=

# Dashboard API access control
# Token required for all non-loopback requests, and for ALL requests in
# production (the loopback bypass is disabled by default outside development).
# The dashboard API reads it from the `hermesdash_token` cookie; a missing or
# mismatched cookie is rejected with 401. Requests fail closed without it —
# never deploy with an empty token. Generate one with: openssl rand -hex 32
NUXT_DASHBOARD_TOKEN=
# Loopback bypass: direct loopback peers (127.0.0.1, ::1) skip token auth.
# Default: enabled in development, disabled in production. Set to "true" to
# explicitly allow the bypass in production, or "false" to require the token
# even on localhost. Leave unset for the safe default.
# NUXT_DASHBOARD_ALLOW_LOOPBACK=false
# Root directory served by /api/files/read (default: the project root).
# To render Hermes images stored outside the project root, set this to a root
# that contains the Hermes image location(s) so they fall inside the served
# boundary (e.g. the Hermes state/images directory).
NUXT_DASHBOARD_FILE_ROOT=
